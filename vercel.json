{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "^/robots\\.txt$",
      "dest": "/api/index.php?resource=robots"
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/api/index.php?resource=sitemap"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}